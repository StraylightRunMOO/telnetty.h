@PACKAGE_INIT@

# Telnetty is header-only. The imported target carries the include path
# and, when this install was built with zlib, TELNETTY_HAVE_ZLIB plus the
# zlib link dependency used by the MCCP2/MCCP3 module.
include(CMakeFindDependencyMacro)
if(@TELNETTY_WITH_ZLIB@)
    find_dependency(ZLIB)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/telnetty-targets.cmake")
check_required_components(telnetty)
